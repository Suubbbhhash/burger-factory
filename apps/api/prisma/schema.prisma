// ============================================
// THE BURGER FACTORY — PRISMA SCHEMA
// PostgreSQL 16 + btree_gist Concurrency Engine
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

enum Role {
  ADMIN
  MANAGER
}

enum Zone {
  INDOOR
  OUTDOOR
  BEACHSIDE
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  ONLINE
  WALK_IN
  PHONE
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum Diet {
  VEG
  EGG
  NON_VEG
}

enum MenuBadge {
  POPULAR
  NEW
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  name               String
  passwordHash       String
  role               Role           @default(MANAGER)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)
  locations          UserLocation[]
  refreshTokens      RefreshToken[]
  reservations       Reservation[]
  auditLogs          AuditLog[]
  @@map("users")
}

model UserLocation {
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("refresh_tokens")
}

model Location {
  id              String         @id @default(uuid()) @db.Uuid
  slug            String         @unique
  name            String
  tag             String?
  area            String
  address         String
  phone           String?
  opensAt         String         @default("12:30")
  lastSeatingAt   String         @default("22:00")
  timezone        String         @default("Asia/Kolkata")
  turnMinutes     Int            @default(90)
  slotStepMinutes Int            @default(30)
  mapUrl          String?
  image           String?
  vibe            String?
  features        String[]
  isActive        Boolean        @default(true)
  tables          DiningTable[]
  reservations    Reservation[]
  staff           UserLocation[]
  @@map("locations")
}

model DiningTable {
  id           String        @id @default(uuid()) @db.Uuid
  locationId   String        @db.Uuid
  label        String        // ANJ-O3, MOR-B1, etc.
  zone         Zone
  capacity     Int
  posX         Int           @default(0)
  posY         Int           @default(0)
  width        Int           @default(2)
  height       Int           @default(2)
  shape        String        @default("rect") // rect | round
  isActive     Boolean       @default(true)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  @@unique([locationId, label])
  @@index([locationId, zone, capacity, isActive])
  @@map("tables")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique // BF-7K9M2W
  locationId      String            @db.Uuid
  tableId         String            @db.Uuid
  guestName       String
  email           String?
  phone           String            // E.164
  partySize       Int
  startsAt        DateTime          @db.Timestamptz(6)
  endsAt          DateTime          @db.Timestamptz(6)
  seatingPref     Zone?
  occasion        String?
  notes           String?
  status          ReservationStatus @default(CONFIRMED)
  source          ReservationSource @default(ONLINE)
  depositStatus   DepositStatus     @default(NOT_REQUIRED)
  depositPaise    Int?
  razorpayOrderId String?           @unique
  createdById     String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  seatedAt        DateTime?         @db.Timestamptz(6)
  completedAt     DateTime?         @db.Timestamptz(6)
  cancelledAt     DateTime?         @db.Timestamptz(6)
  noShowAt        DateTime?         @db.Timestamptz(6)
  location        Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  table           DiningTable       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@index([locationId, startsAt, status])
  @@index([phone, code])
  @@map("reservations")
}

model MenuCategory {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @default(uuid()) @db.Uuid
  categoryId  String       @db.Uuid
  slug        String       @unique
  name        String
  description String
  pricePaise  Int          // stored as integer paise (e.g. 55000 = ₹550)
  diet        Diet
  badge       MenuBadge?
  tags        String[]
  image       String?
  isAvailable Boolean      @default(true)
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@map("menu_items")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId])
  @@map("audit_logs")
}
